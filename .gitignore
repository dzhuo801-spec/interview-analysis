# ---- Python ----
__pycache__/
*.py[cod]
.Python

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- IDE ----
# .idea/ 是整个忽略掉：里面是 PyCharm 的个人配置，跟项目代码无关，
# 传上去只会让仓库变乱。别人 clone 后用自己的 IDE 重新配解释器就行。
.idea/
.vscode/
*.swp

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- matplotlib 字体缓存 ----
.matplotlib/

# ---- 数据（原始数据量大的时候只传脚本，不传数据）----
# 处理后的中间结果不传：
data/processed/
# 原始数据看情况，小文件可以传，大文件写清来源：
# data/raw/*.csv

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 数据库文件（由脚本重新生成，不必上传）----
*.db
*.sqlite3

# ---- 周测临时文件 ----
tests/_tmp/
