# ---- Python ----
__pycache__/
*.py[cod]
.Python

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- IDE ----
# 注意：这里故意不忽略 .idea/
# 因为里面存着「用哪个 Python 解释器」的配置（C:\Python312\python.exe），
# 保留它 = 换电脑或重装后打开项目就能直接跑，不用重新配解释器。
# 但 IDE 的个人界面设置不传：
.idea/workspace.xml
.idea/shelf/
.vscode/
*.swp

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- matplotlib 字体缓存 ----
.matplotlib/

# ---- 数据（原始数据量大的时候只传脚本，不传数据）----
# 处理后的中间结果不传：
data/processed/
# 原始数据看情况，小文件可以传，大文件写清来源：
# data/raw/*.csv

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini
